## 
## Cadence First Encounter "v08.10-p004_1 ((32bit) 11/04/2008 14:34 (Linux 2.6))"
## Fri Oct  9 02:02:00 2026
## 
set sdc_version 1.4
current_design SYS_TOP_dft
create_clock [get_ports {UART_CLK}]  -name UART_CLK -period 271 -waveform {0 135.5}
create_clock [get_ports {REF_CLK}]  -name REF_CLK -period 20 -waveform {0 10}
create_clock [get_ports {scan_clk}]  -name SCAN_CLK -period 100 -waveform {0 50}
set_clock_transition  -rise -min 0.05 [get_clocks {SCAN_CLK}]
set_clock_transition  -rise -max 0.05 [get_clocks {SCAN_CLK}]
set_clock_transition  -fall -min 0.05 [get_clocks {SCAN_CLK}]
set_clock_transition  -fall -max 0.05 [get_clocks {SCAN_CLK}]
set_propagated_clock  [get_ports {UART_CLK}]
set_propagated_clock  [get_pins {u_RX_CLK_DIV/U13/Y}]
set_propagated_clock  [get_ports {scan_clk}]
set_propagated_clock  [get_ports {REF_CLK}]
set_propagated_clock  [get_pins {u_TX_CLK_DIV/U13/Y}]
set_propagated_clock  [get_pins {u_CLK_GATE/U0_TLATNCAX12M/ECK}]
set_driving_cell -lib_cell BUFX2M -rise -min -pin Y -from_pin A [get_ports {test_mode}]
set_driving_cell -lib_cell BUFX2M -fall -min -pin Y -from_pin A [get_ports {test_mode}]
set_driving_cell -lib_cell BUFX2M -rise -max -pin Y -from_pin A [get_ports {test_mode}]
set_driving_cell -lib_cell BUFX2M -fall -max -pin Y -from_pin A [get_ports {test_mode}]
set_driving_cell -lib_cell BUFX2M -rise -min -pin Y -from_pin A [get_ports {SE}]
set_driving_cell -lib_cell BUFX2M -fall -min -pin Y -from_pin A [get_ports {SE}]
set_driving_cell -lib_cell BUFX2M -rise -max -pin Y -from_pin A [get_ports {SE}]
set_driving_cell -lib_cell BUFX2M -fall -max -pin Y -from_pin A [get_ports {SE}]
set_driving_cell -lib_cell BUFX2M -rise -min -pin Y -from_pin A [get_ports {SI[2]}]
set_driving_cell -lib_cell BUFX2M -fall -min -pin Y -from_pin A [get_ports {SI[2]}]
set_driving_cell -lib_cell BUFX2M -rise -max -pin Y -from_pin A [get_ports {SI[2]}]
set_driving_cell -lib_cell BUFX2M -fall -max -pin Y -from_pin A [get_ports {SI[2]}]
set_driving_cell -lib_cell BUFX2M -rise -min -pin Y -from_pin A [get_ports {SI[1]}]
set_driving_cell -lib_cell BUFX2M -fall -min -pin Y -from_pin A [get_ports {SI[1]}]
set_driving_cell -lib_cell BUFX2M -rise -max -pin Y -from_pin A [get_ports {SI[1]}]
set_driving_cell -lib_cell BUFX2M -fall -max -pin Y -from_pin A [get_ports {SI[1]}]
set_driving_cell -lib_cell BUFX2M -rise -min -pin Y -from_pin A [get_ports {SI[0]}]
set_driving_cell -lib_cell BUFX2M -fall -min -pin Y -from_pin A [get_ports {SI[0]}]
set_driving_cell -lib_cell BUFX2M -rise -max -pin Y -from_pin A [get_ports {SI[0]}]
set_driving_cell -lib_cell BUFX2M -fall -max -pin Y -from_pin A [get_ports {SI[0]}]
set_load -pin_load -max  0.1  [get_ports {SO[2]}]
set_load -pin_load -min  0.1  [get_ports {SO[2]}]
set_load -pin_load -max  0.1  [get_ports {SO[1]}]
set_load -pin_load -min  0.1  [get_ports {SO[1]}]
set_load -pin_load -max  0.1  [get_ports {SO[0]}]
set_load -pin_load -min  0.1  [get_ports {SO[0]}]
set_case_analysis 1 [get_ports {SE}]
set_case_analysis 1 [get_ports {test_mode}]
set_input_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SE}]
set_input_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {test_mode}]
set_input_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SI[2]}]
set_input_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SI[0]}]
set_input_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SI[1]}]
set_output_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SO[0]}]
set_output_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SO[1]}]
set_output_delay -add_delay 20 -clock [get_clocks {SCAN_CLK}] [get_ports {SO[2]}]
set_clock_uncertainty 0.1 -hold [get_clocks {SCAN_CLK}]
set_clock_uncertainty 0.2 -setup [get_clocks {SCAN_CLK}]
set_false_path  -from [get_ports {UART_RX_IN scan_rst RST_N}] 
set_false_path  -to [get_ports {framing_error parity_error UART_TX_O}] 
set_clock_groups -name REF_CLK_1 -asynchronous  -group  [get_clocks {SCAN_CLK}] -group  [get_clocks {UART_CLK REF_CLK}]
