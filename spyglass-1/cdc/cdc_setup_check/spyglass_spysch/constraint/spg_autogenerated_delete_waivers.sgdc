#file_type internal
# waive command to take care of waive violations on celldefine or encrypted modules

// spyglass xref filename /mnt/hgfs/Shared_Folder/SYSTEM/<./spyglass-1/cdc/cdc_setup_check/spyglass_spysch/constraint/spg_autogenerated_delete_waivers.sgdc>

waive -ip q%WORK.TLATNCAX12M% -rules ALL -except InfoAnalyzeBBox WarnAnalyzeBBox ErrorAnalyzeBBox FatalAnalyzeBBox RtlcElabError MvvElabError VhElabError ALL_SYNTHERR INFO_1004 INFO_998 -ignore -comment "All modules on which no rule-checking is being done, due to -ignorelibs/-disable_encrypted_hdl_checks/-cell_library options" --delete_internal_use_only

